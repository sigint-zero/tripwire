{
  "name": "tripwire",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --filter @tripwire/server dev",
    "build": "pnpm -r build",
    "start": "node packages/cli/dist/tripwire.mjs",
    "bundle": "pnpm build && pnpm --filter @tripwire/cli pack --pack-destination dist",
    "typecheck": "pnpm -r typecheck"
  }
}
