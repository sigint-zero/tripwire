{
  "name": "tripwire",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --filter @tripwire/server dev",
    "build": "pnpm -r build",
    "start": "node packages/cli/dist/tripwire.mjs",
    "bundle": "pnpm build && pnpm --filter @tripwire/cli pack --pack-destination dist",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
