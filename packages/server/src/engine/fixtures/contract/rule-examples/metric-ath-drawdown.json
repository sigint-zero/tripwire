{
  "version": 1,
  "name": "price sinks far below its high",
  "description": "The running maximum: fires when the price falls to 80% of its all-time high. Demonstrates the ath metric and multiplication.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "warning",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "le",
    "left": {
      "node": "view_call",
      "function": "price() returns (uint256)",
      "args": []
    },
    "right": {
      "node": "arithmetic",
      "op": "mul",
      "left": {
        "node": "metric",
        "metric": "ath",
        "of": {
          "node": "view_call",
          "function": "price() returns (uint256)",
          "args": []
        }
      },
      "right": {
        "node": "literal",
        "value": "0.8"
      }
    }
  },
  "on_trip": {
    "action": "notify"
  }
}
