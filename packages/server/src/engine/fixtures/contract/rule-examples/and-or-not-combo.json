{
  "version": 1,
  "name": "collateralisation breaks while unpaused",
  "description": "Boolean structure: an or of two comparisons, guarded by an and with a negated third. Demonstrates and, or, not and addition.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "and",
    "terms": [
      {
        "node": "or",
        "terms": [
          {
            "node": "compare",
            "op": "lt",
            "left": {
              "node": "view_call",
              "function": "collateral() returns (uint256)",
              "args": []
            },
            "right": {
              "node": "literal",
              "value": "1000000"
            }
          },
          {
            "node": "compare",
            "op": "ge",
            "left": {
              "node": "arithmetic",
              "op": "add",
              "left": {
                "node": "view_call",
                "function": "debt() returns (uint256)",
                "args": []
              },
              "right": {
                "node": "literal",
                "value": "500000"
              }
            },
            "right": {
              "node": "view_call",
              "function": "collateral() returns (uint256)",
              "args": []
            }
          }
        ]
      },
      {
        "node": "not",
        "expr": {
          "node": "compare",
          "op": "eq",
          "left": {
            "node": "view_call",
            "function": "paused() returns (bool)",
            "args": []
          },
          "right": {
            "node": "literal",
            "value": "true"
          }
        }
      }
    ]
  },
  "on_trip": {
    "action": "notify"
  }
}
