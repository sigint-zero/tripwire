{
  "version": 1,
  "name": "oversized withdrawal pauses withdrawals",
  "description": "An event rule with a response: any Withdraw above the threshold trips the withdraw function through the controller. Demonstrates trip_function under an event trigger.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": {
    "event": "Withdraw(address indexed account, uint256 amount)"
  },
  "trip_when": {
    "node": "compare",
    "op": "gt",
    "left": {
      "node": "event_arg",
      "arg": "amount"
    },
    "right": {
      "node": "literal",
      "value": "100000000000000000000"
    }
  },
  "on_trip": {
    "action": "trip_function",
    "function": "withdraw(uint256)",
    "cooldown_seconds": 300
  }
}
