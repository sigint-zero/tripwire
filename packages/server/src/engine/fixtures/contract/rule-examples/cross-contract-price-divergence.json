{
  "version": 1,
  "name": "pool price diverges from the oracle",
  "description": "Two contracts in one rule: the pool's own price divided by the oracle's answer, scaled to a plain ratio. Demonstrates cross-contract view_call, division and scale.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "gt",
    "left": {
      "node": "scale",
      "expr": {
        "node": "arithmetic",
        "op": "div",
        "left": {
          "node": "view_call",
          "function": "price() returns (uint256)",
          "args": []
        },
        "right": {
          "node": "view_call",
          "address": "0x2000000000000000000000000000000000000002",
          "function": "latestAnswer() returns (uint256)",
          "args": []
        }
      },
      "decimals": 0
    },
    "right": {
      "node": "literal",
      "value": "1.02"
    }
  },
  "on_trip": {
    "action": "notify"
  }
}
