{
  "version": 1,
  "name": "supply jumps in one block",
  "description": "Block-over-block movement: the difference between the current supply and its previous-block value. Demonstrates prev_block and subtraction.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "gt",
    "left": {
      "node": "arithmetic",
      "op": "sub",
      "left": {
        "node": "view_call",
        "function": "totalSupply() returns (uint256)",
        "args": []
      },
      "right": {
        "node": "metric",
        "metric": "prev_block",
        "of": {
          "node": "view_call",
          "function": "totalSupply() returns (uint256)",
          "args": []
        }
      }
    },
    "right": {
      "node": "literal",
      "value": "1000000000000000000000"
    }
  },
  "on_trip": {
    "action": "notify"
  }
}
