{
  "version": 1,
  "name": "assets deviate from their daily average",
  "description": "The classic deviation rule: total assets stray more than five percent from their 24h moving average. The response is a call action with verify: paused() must read true afterwards. Demonstrates metric, deviation_band, call and verify.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "deviation_band",
    "value": {
      "node": "view_call",
      "function": "totalAssets() returns (uint256)",
      "args": []
    },
    "center": {
      "node": "metric",
      "metric": "moving_avg",
      "of": {
        "node": "view_call",
        "function": "totalAssets() returns (uint256)",
        "args": []
      },
      "window": {
        "seconds": 86400
      }
    },
    "tolerance_percent": "5",
    "sides": "both"
  },
  "on_trip": {
    "action": "call",
    "call": {
      "function": "pause()",
      "args": [],
      "verify": {
        "node": "compare",
        "op": "eq",
        "left": {
          "node": "view_call",
          "function": "paused() returns (bool)",
          "args": []
        },
        "right": {
          "node": "literal",
          "value": "true"
        }
      }
    },
    "cooldown_seconds": 3600
  }
}
