{
  "version": 1,
  "name": "reserves drain over a day",
  "description": "A signed change over a window: fires when reserves fall by more than the threshold within 24h. Demonstrates windowed_delta and a negative literal.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "lt",
    "left": {
      "node": "metric",
      "metric": "windowed_delta",
      "of": {
        "node": "view_call",
        "function": "reserves() returns (uint256)",
        "args": []
      },
      "window": {
        "seconds": 86400
      }
    },
    "right": {
      "node": "literal",
      "value": "-1000000000000000000000"
    }
  },
  "on_trip": {
    "action": "notify"
  }
}
