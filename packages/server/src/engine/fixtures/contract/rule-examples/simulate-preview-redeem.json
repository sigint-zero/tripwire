{
  "version": 1,
  "name": "redemptions pay out under par",
  "description": "A simulate yielding a value: previewRedeem of one share must not fall below a floor. Demonstrates the value form of simulate and trip_function.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "lt",
    "left": {
      "node": "simulate",
      "call": {
        "function": "previewRedeem(uint256) returns (uint256)",
        "args": [
          "1000000000000000000"
        ]
      },
      "yields": "value"
    },
    "right": {
      "node": "literal",
      "value": "950000000000000000"
    }
  },
  "on_trip": {
    "action": "trip_function",
    "function": "redeem(uint256)",
    "cooldown_seconds": 300
  }
}
