{
  "version": 1,
  "name": "TVL collapses within the hour",
  "description": "Percent decline from the window's maximum to now. Demonstrates windowed_drop escalating to trip_global.",
  "contract": "0x1000000000000000000000000000000000000001",
  "severity": "critical",
  "when": "every_block",
  "trip_when": {
    "node": "compare",
    "op": "gt",
    "left": {
      "node": "metric",
      "metric": "windowed_drop",
      "of": {
        "node": "view_call",
        "function": "tvl() returns (uint256)",
        "args": []
      },
      "window": {
        "seconds": 3600
      }
    },
    "right": {
      "node": "literal",
      "value": "10"
    }
  },
  "on_trip": {
    "action": "trip_global",
    "cooldown_seconds": 900
  }
}
