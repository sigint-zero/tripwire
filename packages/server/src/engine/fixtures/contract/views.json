{
  "postgres_min_major": 14,
  "schema": "api_v1",
  "types": {
    "actions.args": "string[] (the call kind's literal arguments; null for other kinds)",
    "actions.tx": "the same shape as responses.tx",
    "notifications.payload": {
      "_envelope": "every payload additionally carries chain_id (integer) and engine_version (string), completed at insert",
      "action": "for a settlement: id and action_id (the action's id), kind, target, selector, function, value_wei, key, note, then status, tx_hash, block_number and error as for a response; for worker decisions: kind, target, selector, note, status, detail",
      "health": {
        "cause": "string | null (what degrades the engine)",
        "evaluated_block": "integer | null",
        "observed_head": "integer | null",
        "previous": "string | null",
        "status": "starting | ready | degraded"
      },
      "response": {
        "action": "string",
        "contract": "string (0x address)",
        "detail": "string (the reason or problem)",
        "response_id": "integer",
        "rule": "string (name)",
        "rule_id": "integer",
        "severity": "string",
        "status": "string"
      },
      "response (settlement)": {
        "action": "string",
        "block_number": "integer",
        "contract": "string (0x address)",
        "error": "string | null",
        "id": "integer (response id)",
        "response_id": "integer (the same id)",
        "rule": "string (name)",
        "rule_id": "integer",
        "severity": "string",
        "status": "confirmed | failed",
        "tx_hash": "string"
      },
      "violation": {
        "block_number": "integer (for pending: the pinned head, not a landing)",
        "block_time": "string (rfc3339)",
        "contract": "string (0x address)",
        "description": "string (tripped and pending)",
        "evidence": "object (evaluation_error only: path, error)",
        "kind": "tripped | evaluation_error | pending",
        "rule": "string (name)",
        "rule_id": "integer",
        "severity": "string",
        "tx_hash": "string | null (for pending: the pending transaction's hash)",
        "violation_id": "integer"
      }
    },
    "responses.tx": {
      "approval_rebuilt": "boolean",
      "attempts": [
        {
          "broadcast": "boolean (false until a node is known to hold it; absent on older attempts, which were recorded only after a node took them and read as true)",
          "hash": "string",
          "max_fee_per_gas": "string (wei)",
          "max_priority_fee_per_gas": "string (wei)",
          "raw": "string (0x signed transaction, recorded before broadcast)",
          "submitted_block": "integer"
        }
      ],
      "confirmed_block": "integer (once confirmed)",
      "decoded_args": "string[]",
      "function": "string (the call's signature form)",
      "gas_limit": "string",
      "gas_used": "string (once confirmed)",
      "hash": "string (0x hash of the latest attempt)",
      "max_fee_per_gas": "string (wei)",
      "max_priority_fee_per_gas": "string (wei)",
      "nonce": "integer",
      "signer": "string (0x address of the key that signs every attempt; absent on records written before the record named it)",
      "target": "string (0x address)",
      "value": "string (wei)"
    },
    "rules.dependencies": [
      {
        "acknowledged": "boolean (the owner acknowledged it through the control interface)",
        "address": "string (0x address the rule's reads, verify or simulations touched that it neither names nor watches)",
        "first_block": "integer (the block whose evaluation first touched it; after a reorg it may name an abandoned block)"
      }
    ]
  },
